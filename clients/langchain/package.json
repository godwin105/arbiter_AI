{
  "name": "@arbiterlabs/langchain",
  "version": "0.1.0",
  "description": "LangChain tools for Arbiter \u2014 pre-flight judgment for agents that hold a wallet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0 <2.0.0"
  },
  "dependencies": {
    "@arbiterlabs/sdk": "^0.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.4",
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Godwin Tairo",
  "homepage": "https://github.com/godwin105/arbiter_AI/tree/main/clients/langchain#readme",
  "bugs": {
    "url": "https://github.com/godwin105/arbiter_AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwin105/arbiter_AI.git",
    "directory": "clients/langchain"
  },
  "keywords": [
    "langchain",
    "langchain-tools",
    "ai-agent",
    "agent-security",
    "x402",
    "algorand",
    "transaction-simulation",
    "wallet-security"
  ],
  "publishConfig": {
    "access": "public"
  }
}
