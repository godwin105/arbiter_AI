{
  "name": "@arbiter/proxy",
  "version": "0.1.0",
  "description": "Local paying sidecar \u2014 lets agents in any language use Arbiter without an x402 client.",
  "type": "module",
  "bin": {
    "arbiter-proxy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@arbiter/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Godwin Tairo",
  "homepage": "https://github.com/godwin105/arbiter_AI/tree/main/clients/proxy#readme",
  "bugs": {
    "url": "https://github.com/godwin105/arbiter_AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwin105/arbiter_AI.git",
    "directory": "clients/proxy"
  },
  "keywords": [
    "x402",
    "algorand",
    "usdc",
    "micropayments",
    "sidecar",
    "ai-agent",
    "python-agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
