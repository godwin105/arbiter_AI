{
  "name": "@arbiter/proxy",
  "version": "0.1.0",
  "description": "Local paying sidecar — lets agents in any language use Arbiter without an x402 client.",
  "type": "module",
  "bin": {
    "arbiter-proxy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@arbiter/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
