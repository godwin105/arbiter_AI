{
  "name": "@arbiter/eliza",
  "version": "0.1.0",
  "description": "ElizaOS plugin for Arbiter \u2014 judgment before an agent signs or pays.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "dependencies": {
    "@arbiter/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Godwin Tairo",
  "homepage": "https://github.com/godwin105/arbiter_AI/tree/main/clients/eliza#readme",
  "bugs": {
    "url": "https://github.com/godwin105/arbiter_AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwin105/arbiter_AI.git",
    "directory": "clients/eliza"
  },
  "keywords": [
    "elizaos",
    "eliza-plugin",
    "ai-agent",
    "agent-security",
    "x402",
    "algorand",
    "onchain-agent",
    "wallet-security"
  ],
  "publishConfig": {
    "access": "public"
  }
}
