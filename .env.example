# ---------------------------------------------------------------------------
# Arbiter — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# testnet | mainnet
# Build and validate the full request -> payment -> settlement -> response loop
# on testnet first. Testnet activity does NOT count toward the leaderboard.
ARBITER_NETWORK=testnet

# The single Algorand address that receives USDC for ALL routes.
# Challenge rules: keep one consistent payTo for the whole competition, and make
# sure it is opted in to the USDC ASA for the network you are running
# (testnet 10458941 / mainnet 31566704) or settlement will fail.
PAY_TO=

# Public origin of this deployment. Mainnet entries must be public HTTPS.
PUBLIC_URL=http://localhost:4021

PORT=4021

# GoPlausible facilitator. The challenge requires this facilitator specifically;
# using another one means payments are not tracked for the leaderboard.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Optional: override the algod endpoint (defaults to Algonode for the network).
# ALGOD_URL=

LOG_LEVEL=info

# --- KeeperHub (Agents Onchain hackathon) ----------------------------------
# Organization API key from app.keeperhub.com. A secret: keep it in .env only.
KEEPERHUB_API_KEY=

# Base64 Algorand key the agent uses to PAY Arbiter over x402.
# Separate from PAY_TO, which only receives.
ARBITER_PRIVATE_KEY=

# --- Reviewer payouts -------------------------------------------------------
# Account that PAYS reviewers. Use working capital only — keep it separate from
# PAY_TO, which accumulates revenue, so a compromised server cannot drain
# earnings. Needs USDC and a little ALGO for fees.
ARBITER_PAYOUT_MNEMONIC=
# ARBITER_PAYOUT_PRIVATE_KEY=   # base64 alternative to the mnemonic
